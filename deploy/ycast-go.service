[Unit]
Description=YCast (Go) - vTuner internet radio emulation
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/ycast-go -c /etc/ycast/stations.yml -cache /var/cache/ycast-go/icons
Restart=on-failure
RestartSec=5
DynamicUser=yes
CacheDirectory=ycast-go
# Lets the unprivileged service listen on port 80, which receivers require.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
