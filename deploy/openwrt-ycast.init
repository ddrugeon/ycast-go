#!/bin/sh /etc/rc.common
# procd init script for OpenWrt. Install as /etc/init.d/ycast (chmod +x), then:
#   /etc/init.d/ycast enable && /etc/init.d/ycast start
# Note: LuCI's uhttpd also listens on port 80. Move it first, see README.md.

START=95
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/ycast-go -c /etc/ycast/stations.yml -p 80 -cache /tmp/ycast-icons
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
